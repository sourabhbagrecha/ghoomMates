HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Google Cloud SQL (Postgres), shared by all modules. Connects through the Cloud SQL Node.js Connector
# using Application Default Credentials (`gcloud auth application-default login` locally; on Cloud Run the
# service account needs roles/cloudsql.client). Migrations in migrations/ are applied on startup.
# Without a database, auth uses an in-memory store and the expense API (/api/*) is disabled.
CLOUD_SQL_INSTANCE=optimal-comfort-510810-d1:asia-south1:ghoomates
# CLOUD_SQL_IP_TYPE=PUBLIC   # PUBLIC (default), PRIVATE, or PSC
DB_USER=ghoomates
DB_PASSWORD=
DB_NAME=ghoomates
# DB_POOL_SIZE=10

# Alternative to CLOUD_SQL_INSTANCE: any Postgres connection string (local Postgres, Cloud SQL Auth Proxy).
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/ghoomates

# --- Auth (/auth/*) ---
# Secret for signing Ghoomates session JWT tokens (min 32 characters)
JWT_SECRET=replace_with_your_jwt_secret_min_32_characters

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# --- Expenses (/api/*) ---
# Required to enable the expense API: generate with `openssl rand -hex 32`. Internal API access only.
API_KEY=


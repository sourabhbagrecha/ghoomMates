HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas, shared by all modules and the face services in cloud/. Indexes (src/schema.ts) are created on startup.
# Without a database, auth uses an in-memory store and the expense API (/api/*) is disabled.
# Atlas -> Database -> Connect -> Drivers; URL-encode the password. Network Access must allow your IP (Cloud Run needs 0.0.0.0/0).
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=ghoomates
# DB_POOL_SIZE=10

# --- Auth (/auth/*) ---
# Secret for signing GhoomMates session JWT tokens (min 32 characters)
JWT_SECRET=replace_with_your_jwt_secret_min_32_characters

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# --- Expenses (/api/*) ---
# Required to enable the expense API: generate with `openssl rand -hex 32`. Internal API access only.
API_KEY=


# --- Trips (/api/trips/*) ---
# Signed-in users' trips, invites, expenses, photos and itinerary. Needs only the database above.

# Media storage for photos, receipts and selfies. Browsers upload straight to the bucket with signed URLs.
# GCS_CREDENTIALS_BASE64 is a service account JSON key, base64-encoded on one line (`base64 < key.json | tr -d '\n'`);
# the account needs roles/storage.objectAdmin on the bucket, and the bucket needs CORS for PUT/GET from the app.
# No gcloud or Application Default Credentials needed at runtime. Without these, files go to backend/uploads/.
# GCS_BUCKET=ghoomates
# GCS_CREDENTIALS_BASE64=

# Gemini drafts itineraries from the destination, dates, budget and every member's quiz vibe.
# Without a key (or if Gemini fails) a template plan is used.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Stronger model for vision and storytelling, plus image and speech models (src/gemini.ts has the defaults).
# GEMINI_SMART_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Vertex AI for image generation (API-key image quota is often zero). Uses Application Default Credentials:
# `gcloud auth application-default login` locally; on Cloud Run the service account needs roles/aiplatform.user.
# Kaavad Tales also records its storyteller narration through Vertex AI when this is set: the API key's free tier allows
# only 10 speech requests a day, and each story needs one per panel.
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=global

# Reel studio (/api/reels/*): Gemini (GEMINI_SMART_MODEL) looks at up to 24 trip photos and writes the cut for the prompt;
# the app plays it with Remotion and renders the MP4 on the phone. When Gemini fails, Claude writes it from the same
# photos (needs ANTHROPIC_API_KEY, from console.anthropic.com); when both fail, a template cut is used.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Map scenes draw CARTO basemaps (Voyager, Positron, Dark Matter) through /api/reels/tiles/carto/*, which adds this key
# server-side (free key from carto.com/basemaps/apikey; 5M tile requests a month non-commercial, 1M commercial).
# Without it they use Esri's keyless satellite and street tiles.
# CARTO_API_KEY=

# Face matching (POST /api/trips/:id/photos/find-me) runs Atlas Vector Search on the faces the face-indexer in cloud/
# wrote. Cosine distance below which a face is the selfie's person; keep it equal to MATCH_THRESHOLD in cloud/.
# FACE_MATCH_THRESHOLD=0.40

# --- Voice (/api/voice/*, GhoomMate agent worker) ---
# LiveKit Cloud project (Settings -> Keys). Without all three, POST /api/voice/session returns 503 VOICE_DISABLED.
# The agent worker (`npm --prefix backend run agent`) uses the same keys and reaches the model via LiveKit Inference.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Realtime speech-to-speech model and voice for GhoomMate (LiveKit Inference).
# GHOOMATE_MODEL=google/gemini-3.8-live
# GHOOMATE_VOICE=Puck
# Your own worker name in dev (e.g. ghoomate-yourname), so your sessions don't go to a teammate's worker.
# Leave unset in production.
# GHOOMATE_AGENT_NAME=
# Seconds of quiet before GhoomMate says bye and ends the call (so an idle call costs nothing); 0 never hangs up
# GHOOMATE_IDLE_HANGUP_S=30
# Job processes kept warm so a chat starts faster; 0 to always load fresh code
# GHOOMATE_IDLE_PROCESSES=1
# inline: this server runs the voice worker itself, under its own agent name (<GHOOMATE_AGENT_NAME>-<random>), and
# each call holds its POST /api/voice/session request open so Cloud Run keeps the CPU on (backend/docs/voice.md).
# deploy/cloudrun.sh sets it. Unset in local dev, where `npm run dev` runs the worker as its own process.
# VOICE_WORKER=inline
# Base URL the agent worker (and `npm run seed:demo`, backend/docs/demo.md) uses to call this API as a user. Defaults to http://127.0.0.1:<PORT>.
# BACKEND_URL=http://127.0.0.1:3000

# --- Production on Cloud Run (backend/docs/deploy.md; the Docker image and deploy/cloudrun.sh set these) ---
# NODE_ENV=production makes JWT_SECRET mandatory (no public dev fallback), refuses localhost CORS origins and
# turns the mock sign-in off.
# Serve the built web app (frontend/dist) from this server, with a single-page-app fallback. A relative path is
# resolved from the working directory. Locally the Vite dev server serves the app, so leave it unset.
# SERVE_FRONTEND_DIR=../frontend/dist
# POST /auth/dev/login (the quick test accounts on the sign-in page) signs in without a password. On for local dev,
# off when NODE_ENV=production; only "true" turns it on explicitly, any other value turns it off. With
# NODE_ENV=production it only signs in the two demo accounts (Aditi Sharma, Kabir Mehta), never a real user.
# ALLOW_DEV_LOGIN=true
# Production only: replace the demo accounts that the test sign-in may use (comma-separated emails).
# DEV_LOGIN_EMAILS=aditi.travels@gmail.com,kabir.mehta@gmail.com
# The deployed server has a dedicated agent name so sessions never reach a teammate's laptop. deploy/cloudrun.sh sets
# GHOOMATE_AGENT_NAME=ghoomate-prod (AGENT_NAME=... overrides); each instance adds its own suffix.

# --- Heritage Ops (/api/ops/*) ---
# Crowd forecasts from squads' plans, and the advisories site managers publish. Works without a database. For the demo the
# console mixes a clearly labelled sample of simulated squads in with the real plans; set off to count real plans only.
# OPS_SAMPLE_SQUADS=on

# --- Green Trip (/api/impact/*) ---
# Optional: real road and footpath distances for the squad's footprint, from the Google Maps Platform Routes API
# (enable "Routes API" for the key's project; each distance is cached in the database). Without it, distances are
# straight-line estimates × a road factor. Gemini (GEMINI_API_KEY above) is also optional here: it sorts expenses
# the keyword rules can't place and re-words the swap suggestions.
# GOOGLE_MAPS_API_KEY=

{
  "name": "@ghoomates/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "start:bun": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/app.test.ts tests/auth/oauth.test.ts tests/reels/reels.test.ts",
    "test:auth": "node --test tests/auth/oauth.test.ts",
    "test:unit": "bun test tests/expenses/domain.test.ts",
    "test:expenses": "bun test tests/expenses",
    "test:connection": "node scripts/test-firestore-connection.ts",
    "test:flow": "node scripts/test-api.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.0",
    "express": "^5",
    "mongodb": "^7.8.0"
  }
}

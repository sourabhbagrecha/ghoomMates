{
  "name": "@ghoomates/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "start:bun": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/app.test.ts tests/auth/oauth.test.ts",
    "test:auth": "node --test tests/auth/oauth.test.ts",
    "test:unit": "bun test tests/expenses/domain.test.ts",
    "test:expenses": "bun test --timeout 30000 tests/expenses",
    "test:connection": "node scripts/test-db-connection.ts",
    "test:flow": "node scripts/test-api.ts",
    "db:cli": "node scripts/db-cli.ts",
    "psql": "node scripts/db-cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "express": "^5",
    "pg": "^8.23.1"
  }
}

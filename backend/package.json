{
  "name": "@ghoomates/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/app.test.ts tests/auth/oauth.test.ts tests/expenses/domain.test.ts",
    "test:auth": "node --test tests/auth/oauth.test.ts",
    "test:unit": "node --test tests/expenses/domain.test.ts",
    "test:expenses": "node --test --test-timeout=30000 --test-concurrency=1 tests/expenses",
    "test:connection": "node scripts/test-db-connection.ts",
    "test:flow": "node scripts/test-api.ts",
    "db:cli": "node scripts/db-cli.ts",
    "psql": "node scripts/db-cli.ts",
    "test:trips": "node --test --test-timeout=120000 --test-concurrency=1 tests/trips",
    "test:media": "node scripts/test-media.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "@google-cloud/storage": "^7.22.0",
    "express": "^5",
    "pg": "^8.23.1"
  }
}

# Copy to cloud/.env (gitignored, never sent to Cloud Build or into the image).
# Read by deploy.sh (passed to both Cloud Run services) and by `python -m faces.migrate`.
# Same URL as the backend's DATABASE_URL; sslmode=no-verify is accepted and treated as sslmode=require.
DATABASE_URL=postgres://ghoomates:<password>@<cloud-sql-public-ip>:5432/ghoomates?sslmode=no-verify

# Copy to cloud/.env (gitignored, never sent to Cloud Build or into the image).
# Read by deploy.sh (passed to the face-indexer Cloud Run service) and by `python -m faces.migrate`.
# Same cluster and database as the backend's MONGODB_CONNECTION_STRING / MONGODB_DB. Atlas must allow Cloud Run's
# egress IPs (Network Access; 0.0.0.0/0 for the hackathon, since Cloud Run has no fixed IP without a NAT).
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ghoomates

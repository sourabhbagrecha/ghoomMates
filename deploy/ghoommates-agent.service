# GhoomMate voice worker on the VM, next to the web service. deploy/vm.sh installs this file as
# /etc/systemd/system/ghoommates-agent.service and restarts it on every deploy. It reads backend/.env
# (GHOOMATE_AGENT_NAME=ghoomate-prod, LIVEKIT_*) and calls the API on 127.0.0.1:8080. Health port 8081.
[Unit]
Description=Ghoommates GhoomMate voice worker (LiveKit agent)
After=network-online.target ghoommates.service
Wants=network-online.target

[Service]
User=ghoommates
WorkingDirectory=/opt/ghoommates/app/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/voice/agent.ts start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
